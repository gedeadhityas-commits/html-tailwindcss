            'jersey-street': {
                category: 'JERSEY BASKET & STREETWEAR',
                title: 'Streetwear Basketball Kit',
                price: 'Rp199.000',
                image: 'images/jersey-street.jpg',
                thumbnails: [
                    { src: 'images/jersey-street.jpg', label: 'Studio Utama' }
                ],
                desc: 'Jersey basket berpotongan boxy oversized dengan material heavy-gauge athletic mesh hitam pekat, rib rajut belang emas-ungu di kerah dan lengan, serta aplikasi nomor dada berkualitas tinggi.',
                features: ['Bahan heavy-gauge mesh berpori tebal & jatuh', 'Rib kerah dan lingkar lengan rajut dua warna', 'Potongan boxy fit cocok untuk layering kaos'],
                optionLabel: 'Pilih Ukuran:',
                options: ['M', 'L', 'XL', 'XXL']
            },
            'jersey-cycling': {
                category: 'JERSEY SEPEDA ROAD & GRAVEL',
                title: 'Commuter Pro Cycling Jersey',
                price: 'Rp229.000',
                image: 'images/jersey-cycling.jpg',
                thumbnails: [
                    { src: 'images/jersey-cycling.jpg', label: 'Studio Utama' }
                ],
                desc: 'Jersey sepeda aerodinamis dengan ritsleting depan penuh (full-zip), kerah rendah nyaman, 3 saku belakang elastis untuk botol/ponsel, serta manset lengan hi-vis neon terang.',
                features: ['Ritsleting depan penuh (full-length zipper) praktis', '3 saku belakang elastis + silikon gripper pinggang', 'Bahan spandeks lycra aerodinamis UV-protection'],
                optionLabel: 'Pilih Ukuran:',
                options: ['S', 'M', 'L', 'XL']
            },
            'tshirt-oversized': {
                category: 'KAOS POLOS OVERSIZE',
                title: 'Heavyweight Oversized Tee 24s',
                price: 'Rp119.000',
                image: 'images/tshirt-oversized.jpg',
                thumbnails: [
                    { src: 'images/tshirt-oversized.jpg', label: 'Studio Utama' }
                ],
                desc: 'Kaos esensial potongan boxy drop-shoulder dari bahan 100% katun combed 24s tebal yang lembut, tidak menerawang, serta dilengkapi rib leher 3cm yang kokoh dan tidak mudah melar.',
                features: ['100% Cotton Combed 24s tebal & menyerap keringat', 'Pola boxy oversized dengan bahu turun (drop-shoulder)', 'Rib kerah crew neck tebal anti melar'],
                optionLabel: 'Pilih Ukuran:',
                options: ['S', 'M', 'L', 'XL', 'XXL']
            },
            'tshirt-graphic': {
                category: 'KAOS GRAFIS DISTRO',
                title: 'Vintage Tokyo Graphic Tee',
                price: 'Rp139.000',
                image: 'images/tshirt-graphic.jpg',
                thumbnails: [
                    { src: 'images/tshirt-graphic.jpg', label: 'Studio Utama' }
                ],
                desc: 'Kaos streetwear warna broken-white dengan ilustrasi grafis retro Tokyo di bagian dada, dicetak menggunakan tinta plastisol curing matte yang tajam, lentur, dan tidak pecah saat dicuci.',
                features: ['Katun combed premium warna broken-white/cream', 'Sablon plastisol HD matte tahan setrika & cuci', 'Jahitan rantai standar ekspor rapi & kuat'],
                optionLabel: 'Pilih Ukuran:',
                options: ['S', 'M', 'L', 'XL']
            },
            'tshirt-pocket': {
                category: 'KAOS SAKU DADA KASUAL',
                title: 'Minimalist Pocket Tee 30s',
                price: 'Rp109.000',
                image: 'images/tshirt-pocket.jpg',
                thumbnails: [
                    { src: 'images/tshirt-pocket.jpg', label: 'Studio Utama' }
                ],
                desc: 'Kaos harian super adem dari 100% katun combed 30s warna hijau botol (forest green), dipermanis dengan saku dada fungsional beraksen label kulit sintetis minimalis.',
                features: ['100% Cotton Combed 30s ekstra sejuk & ringan', 'Saku dada kiri dengan detail woven leather tag', 'Mudah dipadukan untuk gaya santai maupun kemeja luar'],
                optionLabel: 'Pilih Ukuran:',
                options: ['S', 'M', 'L', 'XL', 'XXL']
            },
            'tshirt-acidwash': {
                category: 'KAOS WASHED STREETWEAR',
                title: 'Acid Wash Grunge Tee',
                price: 'Rp149.000',
                image: 'images/tshirt-acidwash.jpg',
                thumbnails: [
                    { src: 'images/tshirt-acidwash.jpg', label: 'Studio Utama' }
                ],
                desc: 'Kaos streetwear yang melalui proses mineral acid-washing autentik sehingga menghasilkan tekstur warna abu-abu charcoal vintage bergradasi unik dan kain yang terasa sangat lembut.',
                features: ['Proses mineral acid-wash asli berkarakter vintage', 'Bahan katun tebal yang telah melalui pre-shrunk (anti susut)', 'Potongan relaxed fit nyaman untuk gaya harian'],
                optionLabel: 'Pilih Ukuran:',
                options: ['M', 'L', 'XL', 'XXL']
            },
            'tshirt-stripe': {
                category: 'KAOS SALUR GARIS KLASIK',
                title: 'Breton Stripe Nautical Tee',
                price: 'Rp129.000',
                image: 'images/tshirt-stripe.jpg',
                thumbnails: [
                    { src: 'images/tshirt-stripe.jpg', label: 'Studio Utama' }
                ],
                desc: 'Kaos salur horizontal biru navy dan putih bergaya maritim Parisian yang dirajut dari benang celup asli (yarn-dyed cotton), menghasilkan warna garis yang tajam dan tidak pernah luntur.',
                features: ['Rajutan benang celup asli (yarn-dyed) anti pudar', 'Kerah rib solid navy blue dengan bordir dada minimalis', 'Kain katun lembut, adem, dan tidak mudah kusut'],
                optionLabel: 'Pilih Ukuran:',
                options: ['S', 'M', 'L', 'XL']
            }
        };

        // Ambil parameter ?id= dari URL (default ke 'sepatu-urban' jika tidak ada)
        const urlParams = new URLSearchParams(window.location.search);
        const productId = urlParams.get('id') || 'sepatu-urban';
        const product = CATALOG_PRODUCTS[productId] || CATALOG_PRODUCTS['sepatu-urban'];

        // Elemen DOM
        const detailMainImg = document.getElementById('detailMainImgSepatu');
        const thumbsContainer = document.getElementById('detailThumbnailsContainer');
        const detailCategory = document.getElementById('detailCategory');
        const detailTitle = document.getElementById('detailTitle');
        const detailPrice = document.getElementById('detailPrice');
        const detailDesc = document.getElementById('detailDesc');
        const detailFeatures = document.getElementById('detailFeatures');
        const detailOptionTitle = document.getElementById('detailOptionTitle');
        const detailOptionsContainer = document.getElementById('detailOptionsContainer');

        // Render Data Produk secara Konsisten dengan Katalog
        document.title = `Detail Produk - ${product.title} | Toko Urban`;
        detailMainImg.src = product.image;
        detailMainImg.alt = `Foto Studio HD ${product.title}`;
        detailCategory.textContent = product.category;
        detailTitle.textContent = product.title;
        detailPrice.textContent = product.price;
        detailDesc.textContent = product.desc;

        // Render Keunggulan Produk (<ul>)
        detailFeatures.innerHTML = product.features
            .map(feat => `<li>${feat}</li>`)
            .join('');

        // Render Thumbnails Foto Studio HD
        thumbsContainer.innerHTML = product.thumbnails
            .map((thumb, idx) => `
                <button type="button" class="detail-thumb-btn ${idx === 0 ? 'active' : ''}" data-src="${thumb.src}">
                    <img src="${thumb.src}" alt="${thumb.label}">
                    <span>${thumb.label}</span>
                </button>
            `)
            .join('');

        // Pasang event listener untuk ganti foto thumbnail
        const detailThumbBtns = thumbsContainer.querySelectorAll('.detail-thumb-btn');
        detailThumbBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const newSrc = btn.getAttribute('data-src');
                if (newSrc && detailMainImg) {
                    detailMainImg.style.opacity = '0.3';
                    setTimeout(() => {
                        detailMainImg.src = newSrc;
                        detailMainImg.style.opacity = '1';
                    }, 120);

                    detailThumbBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                }
            });
        });

        // Render Pilihan Ukuran / Warna
        detailOptionTitle.textContent = product.optionLabel;
        let selectedOption = product.options[0];
        detailOptionsContainer.innerHTML = product.options
            .map((opt, idx) => `<button type="button" class="size-btn ${idx === 0 ? 'active' : ''}">${opt}</button>`)
            .join('');

        const sizeButtons = detailOptionsContainer.querySelectorAll('.size-btn');
        sizeButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                sizeButtons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                selectedOption = btn.innerText.trim();
            });
        });

        // Beli sekarang via WhatsApp
        document.getElementById('btn-buy-sepatu').addEventListener('click', () => {
            const message = encodeURIComponent(`Halo Toko Urban (IGAS STORE), saya tertarik membeli ${product.title} (${product.optionLabel.replace(':', '')}: ${selectedOption}) dengan harga ${product.price}. Apakah stok masih tersedia?`);
            window.open(`https://wa.me/6281234567890?text=${message}`, '_blank');
        });

        // Dark Mode Toggle & Mobile Menu di Halaman Detail Produk
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const themeToggleIcon = document.getElementById('themeToggleIcon');
        const themeToggleText = document.getElementById('themeToggleText');

        const MOON_SVG_PATH = '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>';
        const SUN_SVG_PATH = '<circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>';

        const syncThemeUI = (theme) => {
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
                if (themeToggleIcon) themeToggleIcon.innerHTML = SUN_SVG_PATH;
                if (themeToggleText) themeToggleText.textContent = 'Mode Terang';
            } else {
                document.documentElement.removeAttribute('data-theme');
                if (themeToggleIcon) themeToggleIcon.innerHTML = MOON_SVG_PATH;
                if (themeToggleText) themeToggleText.textContent = 'Mode Gelap';
            }
        };

        syncThemeUI(localStorage.getItem('igas_theme') || 'light');

        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', () => {
                const currentTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
                const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
                localStorage.setItem('igas_theme', nextTheme);
                syncThemeUI(nextTheme);
            });
        }

        const mobileMenuToggle = document.getElementById('mobileMenuToggle');
        const mainNavbar = document.getElementById('mainNavbar');
        if (mobileMenuToggle && mainNavbar) {
            mobileMenuToggle.addEventListener('click', () => {
                const isOpen = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
                mobileMenuToggle.setAttribute('aria-expanded', !isOpen);
                mobileMenuToggle.classList.toggle('active');
                mainNavbar.classList.toggle('active');
            });
        }
    </script>
</body>

</html>
